Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /Escena_Heliostatos1
        - /Area_Camara1
        - /Imagen_Virtual1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 140
